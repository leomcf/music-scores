% Toggle variables for different analysis layers 
showAnalysisOne = ##t   % First layer: notes against basic blues
showAnalysisTwo = ##f    % Second layer: notes against alternate changes

% First layer: blue circles   (chromatic approach notes against basic blues)
circleNote = 
#(define-music-function (note) (ly:music?)
  (if showAnalysisOne
      #{
        \once \override NoteHead.color = #black
        \once \override NoteHead.stencil = 
        #(lambda (grob)
          (let* ((stil (ly:note-head::print grob)))
            (ly:stencil-add
              stil
              (grob-interpret-markup grob
                (markup
                  #:with-color blue
                  #:translate (cons 0.7 0.0)
                  #:draw-circle 1.0 0.2 #f)))))
        #note
      #}
      note))

% First layer: red circles (notes that don't fit basic blues)
redCircle = {
  #(if showAnalysisOne
     #{
       \once \override NoteHead.layer = #-1
       \once \override NoteHead.stencil = #(lambda (grob)
         (let* ((stil (ly:note-head::print grob)))
           (ly:stencil-add
             stil
             (grob-interpret-markup grob
               (markup
                 #:with-color red
                 #:translate (cons 0.7 0.0)
                 #:draw-circle 1.0 0.2 #f)))))
     #}
     #{ #})
}

% Second layer: orange circles (notes that still don't fit alternate changes)
% Second layer: blue circles (chromatic approach notes against alternate changes)
blueTwo = 
#(define-music-function (note) (ly:music?)
  (if showAnalysisTwo
      #{
        \once \override NoteHead.color = #black
        \once \override NoteHead.stencil = 
        #(lambda (grob)
          (let* ((stil (ly:note-head::print grob)))
            (ly:stencil-add
              stil
              (grob-interpret-markup grob
                (markup
                  #:with-color blue
                  #:translate (cons 0.7 0.0)
                  #:draw-circle 1.0 0.2 #f)))))
        #note
      #}
      note))


% Red asterisk above measure (for analysis layer one)
asteriskOne = 
#(define-music-function () ()
  (if showAnalysisOne
      #{
        ^\markup { \with-color #red \fontsize #6 "*" }
      #}
      #{ #}))

% Second layer: red circles (notes that don't fit alternate changes)
redTwo = {
  #(if showAnalysisTwo
     #{
       \once \override NoteHead.layer = #-1
       \once \override NoteHead.stencil = #(lambda (grob)
         (let* ((stil (ly:note-head::print grob)))
           (ly:stencil-add
             stil
             (grob-interpret-markup grob
               (markup
                 #:with-color red
                 #:translate (cons 0.7 0.0)
                 #:draw-circle 1.0 0.2 #f)))))
     #}
     #{ #})
}


antic = {
  #(if showAnalysisTwo
     #{
       \once \override NoteHead.layer = #-1
       \once \override NoteHead.stencil = #(lambda (grob)
         (let* ((stil (ly:note-head::print grob)))
           (ly:stencil-add
