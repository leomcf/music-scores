             (grob-interpret-markup grob
               (markup
                 #:with-color green
                 #:translate (cons 0.7 0.0)
                 #:draw-circle 1.0 0.2 #f)))))
     #}
     #{ #})
}




% Second layer: orange noteheads (for alternate changes analysis)
orange = {
  #(if showAnalysisTwo
     #{
       \once \override NoteHead.color = #(x11-color 'orange)
     #}
     #{ #})
}


% Conditional parentheses for analysis layer one
parenOne = 
#(define-music-function (note) (ly:music?)
  (if showAnalysisOne
      #{ \parenthesize #note #}
      note))

% Conditional parentheses for analysis layer two
parenTwo = 
#(define-music-function (note) (ly:music?)
  (if showAnalysisTwo
      #{ \parenthesize #note #}
      note))

